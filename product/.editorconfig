# Style for product code only. root = true stops editors from applying settings
# from parent directories; upstream files outside product/ keep their own formatting.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,xml,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
